# Claude Code and push.mjs read these from your shell environment, not from this file.
# Export them before starting Claude Code, or run the script with: node --env-file=.env plugin/scripts/push.mjs ...
# Never paste a key into the chat.

# Required. https://firstflag.io/settings/connect (an agency key reaches every client workspace)
FIRSTFLAG_API_KEY=ff_live_...

# EmailBison: your own instance's API root, and the API key for the client's workspace
EMAILBISON_BASE_URL=https://send.youragency.com/api
EMAILBISON_API_KEY=

# Smartlead: Settings -> API key
SMARTLEAD_API_KEY=

# Instantly (API v2 key): Settings -> Integrations -> API keys
INSTANTLY_API_KEY=
